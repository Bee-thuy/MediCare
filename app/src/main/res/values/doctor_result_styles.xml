<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DoctorResultField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/patient_feedback_field_background</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/manager_ink</item>
        <item name="android:textColorHint">@color/manager_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
