<resources>
    <style name="Theme.MediCare.ClinicalSheet" parent="Theme.MediCare.BottomSheet">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ClinicalLabel">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item><item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">12sp</item><item name="android:textColor">@color/manager_muted</item><item name="android:fontFamily">@font/inter_bold</item>
    </style>
    <style name="ClinicalField">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/patient_feedback_field_background</item><item name="android:padding">12dp</item>
        <item name="android:textSize">13sp</item><item name="android:textColor">@color/manager_ink</item><item name="android:textColorHint">@color/manager_muted</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>
    <style name="ClinicalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/doctor_teal</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ClinicalButton.Secondary" parent="ClinicalButton">
        <item name="android:textColor">@color/doctor_teal_dark</item>
        <item name="backgroundTint">@color/doctor_teal_soft</item>
        <item name="iconTint">@color/doctor_teal_dark</item>
    </style>
    <style name="ClinicalButton.Outline" parent="ClinicalButton">
        <item name="android:textColor">@color/doctor_teal_dark</item>
        <item name="backgroundTint">@color/white</item>
        <item name="iconTint">@color/doctor_teal_dark</item>
        <item name="strokeColor">#D7E8E1</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
</resources>