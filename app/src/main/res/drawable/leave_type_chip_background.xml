<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/doctor_teal_soft" />
            <stroke
                android:width="1.5dp"
                android:color="@color/doctor_teal" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/manager_background" />
            <stroke
                android:width="1dp"
                android:color="@color/manager_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
