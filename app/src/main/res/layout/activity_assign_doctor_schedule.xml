<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/patient_record_sheet_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/patient_profile_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/manager_create_adjust_shift_title"
                android:textColor="@color/manager_ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gán ca làm việc cho bác sĩ theo ngày"
                android:textColor="@color/manager_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/assignScheduleBack"
            style="@style/PatientAccountSheetClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/manager_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/manager_info_background"
                android:fontFamily="@font/inter_medium"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Chọn bác sĩ, ngày và ca làm việc đang hoạt động. Phòng khám và số lượt giúp hệ thống tạo slot đặt lịch."
                android:textColor="@color/manager_blue"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/manager_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Bác sĩ"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/assignScheduleDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/assign_schedule_select_background"
                    android:drawableEnd="@drawable/ic_select_chevron"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="Chọn bác sĩ"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/manager_ink"
                    android:textColorHint="@color/manager_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Ngày làm việc"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/assignScheduleDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/assign_schedule_select_background"
                    android:drawableEnd="@drawable/ic_nav_calendar"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/manager_muted"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/manager_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Ca làm việc"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/assignScheduleShift"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/assign_schedule_select_background"
                    android:drawableEnd="@drawable/ic_select_chevron"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="Chọn ca làm việc"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/manager_ink"
                    android:textColorHint="@color/manager_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/manager_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Phòng khám"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/assignScheduleRoom"
                    style="@style/ClinicalField"
                    android:layout_marginTop="6dp"
                    android:hint="Ví dụ: Phòng 201"
                    android:inputType="textCapSentences" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="Phút / lượt"
                            android:textColor="@color/manager_muted"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/assignScheduleDuration"
                            style="@style/ClinicalField"
                            android:layout_marginTop="6dp"
                            android:hint="30"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="Số lượt tối đa"
                            android:textColor="@color/manager_muted"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/assignScheduleCapacity"
                            style="@style/ClinicalField"
                            android:layout_marginTop="6dp"
                            android:hint="8"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Ghi chú (tùy chọn)"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/assignScheduleNote"
                    style="@style/ClinicalField"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:gravity="top|start"
                    android:hint="Thông tin thêm cho ca làm việc"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="#EEF2F8" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/assignScheduleSave"
        style="@style/ClinicalButton"
        android:text="Tạo ca làm việc"
        app:backgroundTint="@color/manager_blue"
        app:icon="@drawable/ic_visit_check"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/assignScheduleCancel"
        style="@style/ClinicalButton.Outline"
        android:layout_marginTop="8dp"
        android:background="@drawable/doctor_visit_button_outline"
        android:text="@string/manager_cancel"
        android:textColor="@color/manager_blue"
        app:backgroundTint="@null"
        app:icon="@null"
        app:strokeColor="@color/manager_border" />
</LinearLayout>
