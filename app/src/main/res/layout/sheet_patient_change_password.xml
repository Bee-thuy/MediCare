<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/patient_record_sheet_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/PatientAccountSheetTitle" android:text="Đổi mật khẩu" />
        <TextView android:id="@+id/patientPasswordClose" style="@style/PatientAccountSheetClose" />
    </LinearLayout>
    <TextView style="@style/PatientAccountFieldLabel" android:layout_marginTop="16dp"
        android:text="Mật khẩu cũ" />
    <EditText android:id="@+id/patientPasswordCurrent" style="@style/PatientAccountField"
        android:hint="Nhập mật khẩu hiện tại" android:inputType="textPassword" />
    <TextView style="@style/PatientAccountFieldLabel" android:layout_marginTop="12dp"
        android:text="Mật khẩu mới" />
    <EditText android:id="@+id/patientPasswordInput" style="@style/PatientAccountField"
        android:hint="Ít nhất 8 ký tự" android:inputType="textPassword" />
    <com.google.android.material.button.MaterialButton android:id="@+id/patientPasswordSave"
        style="@style/PatientAccountSheetButton" android:layout_marginTop="14dp"
        android:text="Lưu mật khẩu" />
</LinearLayout>
