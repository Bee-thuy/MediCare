<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/patient_record_sheet_background"
    android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/patientRecordDialogTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/inter_bold" android:textColor="@color/manager_ink"
            android:textSize="17sp" />
        <TextView android:id="@+id/patientRecordDialogClose" android:layout_width="32dp"
            android:layout_height="32dp" android:background="@drawable/patient_avatar_background"
            android:gravity="center" android:text="×" android:textColor="@color/manager_muted"
            android:textSize="21sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:fillViewport="true"
        android:maxHeight="450dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/patientRecordDialogContent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/manager_card_background"
            android:orientation="vertical" android:padding="15dp" />
    </ScrollView>
    <TextView android:id="@+id/patientRecordDialogAction"
        android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/patient_booking_button_background"
        android:gravity="center" android:textColor="@color/white"
        android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
