<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@color/white"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/patientChromeNavAccount"
        style="@style/RoleBottomItem"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/patientChromeNavAccountIcon"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/patient_nav_icon_background"
            android:contentDescription="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_account"
            android:tint="@color/nav_tint_patient" />
        <TextView
            android:id="@+id/patientChromeNavAccountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:text="Tài khoản"
            android:textColor="@color/nav_tint_patient"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/patientChromeNavHome"
        style="@style/RoleBottomItem"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/patientChromeNavHomeIcon"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/patient_nav_icon_background"
            android:contentDescription="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_home"
            android:tint="@color/nav_tint_patient" />
        <TextView
            android:id="@+id/patientChromeNavHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:text="Trang chủ"
            android:textColor="@color/nav_tint_patient"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/patientChromeNavSearch"
        style="@style/RoleBottomItem"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/patientChromeNavSearchIcon"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/patient_nav_icon_background"
            android:contentDescription="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_search"
            android:tint="@color/nav_tint_patient" />
        <TextView
            android:id="@+id/patientChromeNavSearchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:text="Tìm bác sĩ"
            android:textColor="@color/nav_tint_patient"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/patientChromeNavBooking"
        style="@style/RoleBottomItem"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/patientChromeNavBookingIcon"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/patient_nav_icon_background"
            android:contentDescription="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_calendar"
            android:tint="@color/nav_tint_patient" />
        <TextView
            android:id="@+id/patientChromeNavBookingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:text="Đặt lịch"
            android:textColor="@color/nav_tint_patient"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/patientChromeNavCatalog"
        style="@style/RoleBottomItem"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/patientChromeNavCatalogIcon"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/patient_nav_icon_background"
            android:contentDescription="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_menu"
            android:tint="@color/nav_tint_patient" />
        <TextView
            android:id="@+id/patientChromeNavCatalogLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:text="Danh mục"
            android:textColor="@color/nav_tint_patient"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
