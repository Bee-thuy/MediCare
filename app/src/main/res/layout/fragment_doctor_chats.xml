<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold" android:text="Cuộc trò chuyện"
        android:textColor="@color/manager_ink" android:textSize="17sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Chọn bệnh nhân để bắt đầu tư vấn"
        android:textColor="@color/manager_muted" android:textSize="12sp" />
    <EditText android:id="@+id/doctorChatSearch" android:layout_width="match_parent"
        android:layout_height="46dp" android:layout_marginTop="16dp"
        android:background="@drawable/patient_feedback_field_background"
        android:hint="🔍  Tìm bệnh nhân" android:inputType="textPersonName"
        android:paddingHorizontal="14dp" android:singleLine="true"
        android:textColor="@color/manager_ink" android:textColorHint="@color/manager_muted"
        android:textSize="13sp" />
    <LinearLayout android:id="@+id/doctorChatAdmin" android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_marginTop="14dp"
        android:background="@drawable/manager_card_background"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="13dp">
        <TextView android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/doctor_avatar_background"
            android:gravity="center" android:text="🛡️" android:textSize="21sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="11dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold" android:text="Admin"
                android:textColor="@color/manager_ink" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Trao đổi với quản trị viên"
                android:textColor="@color/manager_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="›" android:textColor="@color/manager_muted"
            android:textSize="23sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:fontFamily="@font/inter_bold"
        android:text="Bệnh nhân" android:textColor="@color/manager_ink"
        android:textSize="14sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/doctorChatPatientList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
