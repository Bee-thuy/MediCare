<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/patient_record_sheet_background" android:orientation="vertical" android:paddingTop="12dp" android:focusableInTouchMode="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp">
        <TextView android:id="@+id/completeAppointmentTitle" style="@style/PatientAccountSheetTitle" android:text="🩺 Phiên khám &amp; kết quả" />
        <TextView android:id="@+id/completeAppointmentBack" style="@style/PatientAccountSheetClose" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Đóng" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/manager_card_background" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bệnh nhân" android:textColor="@color/manager_muted" android:textSize="13sp" />
                    <TextView android:id="@+id/completeAppointmentPatientName" android:layout_width="0dp" android:layout_weight="2" android:gravity="end" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold" android:textColor="@color/manager_ink" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ngày / giờ" android:textColor="@color/manager_muted" android:textSize="13sp" />
                    <TextView android:id="@+id/completeAppointmentInfo" android:layout_width="0dp" android:layout_weight="2" android:gravity="end" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold" android:textColor="@color/manager_ink" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lý do" android:textColor="@color/manager_muted" android:textSize="13sp" />
                    <TextView android:id="@+id/completeAppointmentReason" android:layout_width="0dp" android:layout_weight="2" android:gravity="end" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold" android:textColor="@color/manager_ink" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Triệu chứng *" android:textColor="@color/manager_ink" android:textSize="12sp" android:textStyle="bold" />
            <EditText android:id="@+id/completeAppointmentSymptoms" style="@style/DoctorResultField" android:hint="Nhập triệu chứng sau khám" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Chẩn đoán *" android:textColor="@color/manager_ink" android:textSize="12sp" android:textStyle="bold" />
            <EditText android:id="@+id/completeAppointmentDiagnosis" style="@style/DoctorResultField" android:hint="Nhập chẩn đoán sau khám" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Hướng điều trị" android:textColor="@color/manager_ink" android:textSize="12sp" android:textStyle="bold" />
            <EditText android:id="@+id/completeAppointmentTreatment" style="@style/DoctorResultField" android:hint="Nhập hướng điều trị" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Lời dặn" android:textColor="@color/manager_ink" android:textSize="12sp" android:textStyle="bold" />
            <EditText android:id="@+id/completeAppointmentInstructions" style="@style/DoctorResultField" android:hint="Lời dặn bệnh nhân" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Đơn thuốc (tùy chọn)" android:textColor="@color/manager_ink" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/completeAppointmentItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/completeAppointmentAddMedication" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="+ Thêm thuốc" android:textAllCaps="false" android:textColor="@color/doctor_teal" app:cornerRadius="12dp" app:strokeColor="@color/doctor_teal" app:strokeWidth="1dp" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/completeAppointmentPublished" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:padding="14dp" android:background="@drawable/doctor_result_published_background" android:text="✓ Kết quả này đã được công bố cho bệnh nhân." android:textColor="@color/doctor_teal_dark" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="10dp" android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/completeAppointmentDraft" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="Lưu nháp" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/doctor_teal_dark" app:backgroundTint="@color/doctor_teal_soft" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/completeAppointmentSave" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Hoàn tất &amp; công bố" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/doctor_teal" app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>