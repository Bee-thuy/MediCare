<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="9dp" android:background="@drawable/manager_card_background"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp">
    <TextView android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/doctor_avatar_background" android:gravity="center"
        android:text="🌞" android:textSize="18sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/doctorWorkRowDate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/manager_ink" android:textSize="12sp" />
        <TextView android:id="@+id/doctorWorkRowInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/manager_muted" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/doctorWorkRowStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/manager_status_active_background"
        android:paddingHorizontal="7dp" android:paddingVertical="5dp" android:textColor="@color/manager_green"
        android:textSize="10sp" />
</LinearLayout>
