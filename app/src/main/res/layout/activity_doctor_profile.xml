<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:id="@+id/doctorProfileHeader" android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@color/doctor_teal_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/doctorProfileBack" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Bác sĩ" android:textColor="#D7F4E9" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold" android:text="Hồ sơ cá nhân"
                android:textColor="@color/white" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/manager_card_background" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="72dp" android:layout_height="72dp"
                    android:background="@drawable/doctor_avatar_background" android:gravity="center"
                    android:text="👨‍⚕️" android:textSize="38sp" />
                <TextView android:id="@+id/doctorProfileName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold" android:gravity="center"
                    android:textColor="@color/manager_ink" android:textSize="18sp" />
                <TextView android:id="@+id/doctorProfileSpecialty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                    android:textColor="@color/manager_muted" android:textSize="11sp" />
                <TextView android:id="@+id/doctorProfileRating" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center"
                    android:textColor="@color/doctor_teal" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:fontFamily="@font/inter_bold"
                android:text="Thông tin cá nhân" android:textColor="@color/manager_ink" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/manager_card_background"
                android:orientation="vertical" android:padding="13dp">
                <LinearLayout style="@style/DoctorProfileRow">
                    <TextView style="@style/DoctorProfileLabel" android:text="Số điện thoại" />
                    <TextView android:id="@+id/doctorProfilePhone" style="@style/DoctorProfileValue" />
                </LinearLayout>
                <LinearLayout style="@style/DoctorProfileRow">
                    <TextView style="@style/DoctorProfileLabel" android:text="Chuyên khoa" />
                    <TextView android:id="@+id/doctorProfileFieldSpecialty" style="@style/DoctorProfileValue" />
                </LinearLayout>
                <LinearLayout style="@style/DoctorProfileRow">
                    <TextView style="@style/DoctorProfileLabel" android:text="Kinh nghiệm" />
                    <TextView android:id="@+id/doctorProfileExperience" style="@style/DoctorProfileValue" />
                </LinearLayout>
                <LinearLayout style="@style/DoctorProfileRow">
                    <TextView style="@style/DoctorProfileLabel" android:text="Trạng thái" />
                    <TextView android:id="@+id/doctorProfileStatus" style="@style/DoctorProfileValue"
                        android:background="@drawable/manager_status_active_background"
                        android:paddingHorizontal="7dp" android:paddingVertical="4dp"
                        android:textColor="@color/doctor_teal_dark" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/doctorProfileEdit" style="@style/DoctorProfileAction"
                android:layout_marginTop="14dp" android:background="@drawable/doctor_primary_button_background"
                android:text="✏️ Chỉnh sửa hồ sơ" android:textColor="@color/white" />
            <TextView android:id="@+id/doctorProfilePassword" style="@style/DoctorProfileAction"
                android:layout_marginTop="9dp" android:background="@drawable/manager_card_background"
                android:text="🔒 Đổi mật khẩu" android:textColor="@color/doctor_teal" />
            <TextView android:id="@+id/doctorProfileLogout" style="@style/DoctorProfileAction"
                android:layout_marginTop="9dp" android:background="@drawable/manager_card_background"
                android:text="🚪 Đăng xuất" android:textColor="@color/manager_muted" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="13dp" android:background="@drawable/manager_info_background"
                android:padding="14dp" android:text="ℹ️ Để đổi chuyên khoa hoặc bằng cấp đã xác minh, cần yêu cầu Admin xử lý."
                android:textColor="@color/doctor_teal_dark" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
