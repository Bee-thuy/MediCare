<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/manager_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/managedSpecialtyIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/manager_appointment_avatar_background"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_manager_specialty" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/managedSpecialtyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:maxLines="1"
            android:textColor="@color/manager_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/managedSpecialtyCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/manager_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/managedSpecialtyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="10sp" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_select_chevron"
        android:tint="@color/manager_muted" />
</LinearLayout>
