<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/appointmentConflictWarning"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/manager_conflict_filter_background"
            android:padding="13dp" android:textColor="@color/manager_red"
            android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Danh sách yêu cầu" android:textColor="@color/manager_ink"
                android:textSize="15sp" />
            <TextView android:id="@+id/appointmentCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/manager_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/appointmentAllTab" style="@style/ManagerAppointmentChip"
                    android:text="Tất cả" />
                <TextView android:id="@+id/appointmentPendingTab" style="@style/ManagerAppointmentChip"
                    android:text="Chờ duyệt" />
                <TextView android:id="@+id/appointmentConfirmedTab" style="@style/ManagerAppointmentChip"
                    android:text="Đã xác nhận" />
                <TextView android:id="@+id/appointmentRejectedTab" style="@style/ManagerAppointmentChip"
                    android:text="Từ chối" />
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:id="@+id/appointmentFiltersToggle"
            android:layout_width="match_parent" android:layout_height="36dp"
            android:gravity="center_vertical|end" android:text="Lọc ngày, bác sĩ  ▾"
            android:textColor="@color/manager_blue" android:textSize="11sp" />
        <LinearLayout android:id="@+id/appointmentFiltersPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/appointmentTimeFilter"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:background="@drawable/manager_card_background" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:text="Ngày khám ▾"
                android:textColor="@color/manager_muted" android:textSize="11sp" />
            <TextView android:id="@+id/appointmentDoctorFilter"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:background="@drawable/manager_card_background"
                android:gravity="center_vertical" android:paddingHorizontal="12dp"
                android:text="Tất cả bác sĩ ▾" android:textColor="@color/manager_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/appointmentEmpty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="30dp" android:gravity="center"
            android:padding="20dp" android:text="🗓️  Chưa có lịch ở trạng thái này"
            android:textColor="@color/manager_muted" android:textSize="12sp"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/appointmentsList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" />
        <TextView android:id="@+id/appointmentConflictFilter"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="12dp" android:background="@drawable/manager_secondary_action_background"
            android:gravity="center" android:text="⚠️  Kiểm tra lịch trùng"
            android:textColor="@color/manager_blue_dark" android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
