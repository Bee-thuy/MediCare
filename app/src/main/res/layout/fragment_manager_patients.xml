<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/manager_booking_schedule"
                android:textColor="@color/manager_ink"
                android:textSize="22sp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="@color/manager_ink"
                android:textSize="31sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appointmentAllTab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/manager_appointment_tab_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/manager_appointment_all"
                android:textColor="@color/manager_ink"
                android:maxLines="2"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appointmentPendingTab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/manager_appointment_tab_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/manager_appointment_pending"
                android:textColor="@color/manager_ink"
                android:maxLines="2"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appointmentConfirmedTab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/manager_appointment_tab_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/manager_appointment_confirmed"
                android:textColor="@color/manager_ink"
                android:maxLines="2"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appointmentRejectedTab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/manager_appointment_tab_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/manager_appointment_rejected_tab"
                android:textColor="@color/manager_ink"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appointmentTimeFilter"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/manager_card_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/manager_appointment_time_filter"
                android:textColor="@color/manager_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/appointmentDoctorFilter"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.1"
                android:background="@drawable/manager_card_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/manager_appointment_doctor_filter"
                android:textColor="@color/manager_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/appointmentConflictFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/manager_conflict_filter_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:textColor="@color/manager_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appointmentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:gravity="center"
            android:text="@string/manager_no_appointments"
            android:textColor="@color/manager_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/appointmentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
