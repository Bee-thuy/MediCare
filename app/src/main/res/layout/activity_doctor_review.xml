<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <include layout="@layout/view_patient_role_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/reviewBack" android:layout_width="wrap_content"
                android:layout_height="38dp" android:gravity="center_vertical"
                android:text="← Quay lại" android:textColor="@color/patient_purple"
                android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/manager_card_background"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/reviewDoctorName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="@font/inter_bold"
                    android:textColor="@color/manager_ink" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="Đánh giá sau lần khám"
                    android:textColor="@color/manager_muted" android:textSize="11sp" />
            </LinearLayout>
            <RatingBar android:id="@+id/reviewRating" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp" android:numStars="5" android:rating="5"
                android:stepSize="1" android:progressTint="#FFB020"
                android:progressBackgroundTint="#D7DFEA" android:secondaryProgressTint="#FFB020" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:fontFamily="@font/inter_bold"
                android:text="Nhận xét của bạn" android:textColor="@color/manager_ink"
                android:textSize="12sp" />
            <EditText android:id="@+id/reviewComment" android:layout_width="match_parent"
                android:layout_height="100dp" android:layout_marginTop="7dp"
                android:background="@drawable/patient_feedback_field_background"
                android:gravity="top" android:hint="Bạn đánh giá thế nào về trải nghiệm?"
                android:inputType="textCapSentences|textMultiLine" android:padding="13dp"
                android:textColor="@color/manager_ink" android:textColorHint="@color/manager_muted"
                android:textSize="11sp" />
            <TextView android:id="@+id/reviewSave" android:layout_width="match_parent"
                android:layout_height="42dp" android:layout_marginTop="14dp"
                android:background="@drawable/patient_booking_button_background"
                android:gravity="center" android:text="Gửi đánh giá" android:textColor="@color/white"
                android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_patient_role_bottom_navigation" />
</LinearLayout>
