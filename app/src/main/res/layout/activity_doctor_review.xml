<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/manager_background" android:orientation="vertical" android:padding="20dp">
  <TextView android:id="@+id/reviewBack" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center_vertical" android:text="‹" android:textColor="@color/manager_ink" android:textSize="38sp"/>
  <TextView android:id="@+id/reviewDoctorName" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold" android:textColor="@color/manager_ink" android:textSize="23sp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/review_prompt" android:textColor="@color/manager_muted"/>
  <RatingBar android:id="@+id/reviewRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:numStars="5" android:stepSize="1"/>
  <EditText android:id="@+id/reviewComment" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="18dp" android:background="@drawable/manager_card_background" android:gravity="top" android:hint="@string/review_comment_hint" android:inputType="textMultiLine" android:padding="16dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/reviewSave" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/review_save" android:textAllCaps="false"/>
</LinearLayout>
