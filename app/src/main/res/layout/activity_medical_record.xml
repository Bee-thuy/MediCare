<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <include layout="@layout/view_patient_role_header" />
    <ScrollView android:id="@+id/medicalRecordScroll"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/medicalRecordBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="@string/auth_back"
            android:textColor="@color/patient_purple"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/patient_record_title"
            android:textColor="@color/manager_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/medicalRecordDoctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/manager_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/medicalRecordSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/manager_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/medicalRecordDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/manager_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/medicalRecordEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:gravity="center"
            android:textColor="@color/manager_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/medicalRecordContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/doctor_symptoms"
                android:textColor="@color/manager_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medicalRecordSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/manager_card_background"
                android:padding="14dp"
                android:textColor="@color/manager_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/doctor_diagnosis"
                android:textColor="@color/manager_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medicalRecordDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/manager_card_background"
                android:padding="14dp"
                android:textColor="@color/manager_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/doctor_treatment_notes"
                android:textColor="@color/manager_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medicalRecordTreatment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/manager_card_background"
                android:padding="14dp"
                android:textColor="@color/manager_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/doctor_instructions"
                android:textColor="@color/manager_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medicalRecordInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/manager_card_background"
                android:padding="14dp"
                android:textColor="@color/manager_ink" />

            <LinearLayout
                android:id="@+id/medicalRecordPrescriptionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_prescription_title"
                    android:textColor="@color/manager_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/medicalRecordPrescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/manager_card_background"
                    android:padding="14dp"
                    android:textColor="@color/manager_ink" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_patient_role_bottom_navigation" />
</LinearLayout>
