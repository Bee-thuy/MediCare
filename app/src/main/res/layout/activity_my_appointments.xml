<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <include layout="@layout/view_patient_role_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/myAppointmentsBack" android:layout_width="0dp"
                android:layout_height="0dp" android:visibility="gone" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="33dp"
                android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/myAppointmentsAllTab" style="@style/PatientAppointmentChip"
                        android:text="Tất cả" />
                    <TextView android:id="@+id/myAppointmentsPendingTab" style="@style/PatientAppointmentChip"
                        android:text="Chờ duyệt" />
                    <TextView android:id="@+id/myAppointmentsConfirmedTab" style="@style/PatientAppointmentChip"
                        android:text="Đã duyệt" />
                    <TextView android:id="@+id/myAppointmentsProposedTab" style="@style/PatientAppointmentChip"
                        android:text="Đổi giờ" />
                    <TextView android:id="@+id/myAppointmentsCompletedTab" style="@style/PatientAppointmentChip"
                        android:text="Đã khám" />
                    <TextView android:id="@+id/myAppointmentsCancelledTab" style="@style/PatientAppointmentChip"
                        android:text="Đã hủy" />
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout android:id="@+id/myAppointmentsList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <TextView android:id="@+id/myAppointmentsEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:gravity="center" android:text="Không có lịch khám phù hợp"
                android:textColor="@color/manager_muted" android:textSize="11sp"
                android:visibility="gone" />
            <TextView android:id="@+id/myAppointmentsNew" android:layout_width="match_parent"
                android:layout_height="40dp" android:layout_marginTop="12dp"
                android:background="@drawable/patient_booking_button_background"
                android:gravity="center" android:text="+ Đặt lịch khám mới"
                android:textColor="@color/white" android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_patient_role_bottom_navigation" />
</LinearLayout>
