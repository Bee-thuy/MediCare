<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <EditText android:id="@+id/patientSearchInput" android:layout_width="match_parent"
        android:layout_height="43dp" android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp" android:background="@drawable/manager_card_background"
        android:hint="🔍  Tìm theo tên bác sĩ, chuyên khoa..." android:inputType="text"
        android:paddingHorizontal="13dp" android:singleLine="true"
        android:textColor="@color/manager_ink" android:textColorHint="@color/manager_muted"
        android:textSize="11sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="45dp"
        android:layout_marginTop="8dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/patientSearchChips" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingHorizontal="16dp" />
    </HorizontalScrollView>
    <TextView android:id="@+id/patientSearchCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:paddingHorizontal="16dp" android:fontFamily="@font/inter_bold"
        android:text="Kết quả tìm kiếm (0)" android:textColor="@color/manager_ink"
        android:textSize="13sp" />
    <TextView android:id="@+id/patientSearchEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:gravity="center" android:text="Đang tải bác sĩ…"
        android:textColor="@color/manager_muted" android:textSize="11sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/patientSearchList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false"
        android:paddingBottom="16dp" android:paddingHorizontal="16dp" />
</LinearLayout>
