<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <include layout="@layout/view_patient_role_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/addReminderBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="@string/auth_back"
            android:textColor="@color/patient_purple"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/reminder_add_title"
            android:textColor="@color/manager_ink"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/addReminderMedicationName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/manager_card_background"
            android:hint="@string/reminder_medication_name"
            android:paddingHorizontal="14dp" />
        <EditText
            android:id="@+id/addReminderDosage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/manager_card_background"
            android:hint="@string/reminder_dosage"
            android:paddingHorizontal="14dp" />
        <EditText
            android:id="@+id/addReminderTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/manager_card_background"
            android:clickable="true"
            android:focusable="false"
            android:hint="@string/reminder_time"
            android:paddingHorizontal="14dp" />
        <EditText
            android:id="@+id/addReminderFrequency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/manager_card_background"
            android:hint="@string/reminder_frequency"
            android:paddingHorizontal="14dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addReminderSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="@string/reminder_save"
            android:textAllCaps="false"
            app:backgroundTint="@color/patient_purple" />
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_patient_role_bottom_navigation" />
</LinearLayout>
