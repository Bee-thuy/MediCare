<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@color/patient_purple_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/patientChatsBack" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Bệnh nhân" android:textColor="#E5DFFF" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold" android:text="Chat tư vấn bác sĩ"
                android:textColor="@color/white" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:text="Cuộc trò chuyện của bạn"
        android:textColor="@color/manager_ink" android:textSize="15sp"
        android:fontFamily="@font/inter_bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:id="@+id/patientChatsList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingHorizontal="16dp" />
    </ScrollView>
    <TextView android:id="@+id/patientChatsEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:padding="20dp"
        android:text="Chưa có cuộc trò chuyện. Chat sẽ mở khi lịch khám được xác nhận."
        android:textColor="@color/manager_muted" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
