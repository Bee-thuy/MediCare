<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/manager_background" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/profileBack" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:text="@string/auth_back" android:textColor="@color/patient_purple" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="@font/plus_jakarta_sans_bold" android:text="@string/profile_title" android:textColor="@color/manager_ink" android:textSize="25sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/profile_subtitle" android:textColor="@color/manager_muted"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/profileChooseAvatar" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="16dp" android:text="@string/profile_choose_avatar" android:textAllCaps="false" />
    <EditText android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:background="@drawable/manager_card_background" android:hint="@string/auth_full_name" android:paddingHorizontal="14dp"/>
    <EditText android:id="@+id/profilePhone" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/manager_card_background" android:hint="@string/auth_phone" android:inputType="phone" android:paddingHorizontal="14dp"/>
    <EditText android:id="@+id/profileEmail" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/manager_card_background" android:enabled="false" android:hint="@string/auth_email" android:paddingHorizontal="14dp"/>
    <LinearLayout android:id="@+id/profileDoctorInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/profile_professional_information" android:textColor="@color/manager_ink" android:textStyle="bold" />
        <EditText android:id="@+id/profileSpecialty" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/manager_card_background" android:enabled="false" android:hint="@string/manager_specialty" android:paddingHorizontal="14dp" />
        <EditText android:id="@+id/profileExperience" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/manager_card_background" android:enabled="false" android:hint="@string/manager_experience" android:paddingHorizontal="14dp" />
        <EditText android:id="@+id/profileBiography" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="12dp" android:background="@drawable/manager_card_background" android:gravity="top|start" android:hint="@string/manager_biography" android:inputType="textMultiLine|textCapSentences" android:padding="14dp" />
        <EditText android:id="@+id/profileWorkplace" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/manager_card_background" android:hint="@string/profile_workplace" android:paddingHorizontal="14dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/profileChangePassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="@string/profile_change_password" android:textAllCaps="false" app:strokeColor="@color/patient_purple" app:strokeWidth="1dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/profileSave" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:text="@string/profile_save" android:textAllCaps="false" app:backgroundTint="@color/patient_purple"/>
</LinearLayout>
