<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="38dp"
        android:paddingBottom="30dp">

        <ImageButton
            android:id="@+id/registerBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:padding="12dp"
            android:src="@drawable/ic_auth_back" />

        <ImageView
            android:layout_width="104dp"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_app" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:text="@string/register_title"
            android:textColor="@color/auth_text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textColor="@color/onboarding_body"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registerNameLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:hint="@string/auth_full_name"
            app:boxBackgroundColor="@color/auth_input_background"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/auth_blue"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:startIconDrawable="@drawable/ic_auth_person"
            app:startIconTint="@color/auth_input_icon">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerNameInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="name"
                android:fontFamily="@font/plu_jakarta_sans_regular"
                android:inputType="textPersonName"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registerEmailLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:hint="@string/auth_email"
            app:boxBackgroundColor="@color/auth_input_background"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/auth_blue"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:startIconDrawable="@drawable/ic_auth_email"
            app:startIconTint="@color/auth_input_icon">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerEmailInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="emailAddress"
                android:fontFamily="@font/plu_jakarta_sans_regular"
                android:inputType="textEmailAddress"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registerPhoneLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:hint="@string/auth_phone"
            app:boxBackgroundColor="@color/auth_input_background"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/auth_blue"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:startIconDrawable="@drawable/ic_auth_phone"
            app:startIconTint="@color/auth_input_icon">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="phone"
                android:fontFamily="@font/plu_jakarta_sans_regular"
                android:inputType="phone"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registerPasswordLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:hint="@string/auth_password"
            app:boxBackgroundColor="@color/auth_input_background"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/auth_blue"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/auth_input_icon"
            app:startIconDrawable="@drawable/ic_auth_lock"
            app:startIconTint="@color/auth_input_icon">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="newPassword"
                android:fontFamily="@font/plu_jakarta_sans_regular"
                android:inputType="textPassword"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registerConfirmPasswordLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:hint="@string/auth_confirm_password"
            app:boxBackgroundColor="@color/auth_input_background"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/auth_blue"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/auth_input_icon"
            app:startIconDrawable="@drawable/ic_auth_lock"
            app:startIconTint="@color/auth_input_icon">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerConfirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="newPassword"
                android:fontFamily="@font/plu_jakarta_sans_regular"
                android:inputType="textPassword"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/registerTerms"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="@string/register_terms"
            android:textColor="@color/auth_text"
            android:textSize="14sp"
            app:buttonTint="@color/auth_blue" />

        <TextView
            android:id="@+id/registerMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/auth_message_background"
            android:padding="12dp"
            android:textColor="@color/auth_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/register_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/auth_blue"
            app:cornerRadius="30dp" />

        <ProgressBar
            android:id="@+id/registerLoading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/auth_blue"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/auth_divider" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:text="@string/auth_or_continue_with"
                android:textColor="@color/onboarding_body"
                android:textSize="16sp" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/auth_divider" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewRegisterFb"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/auth_continue_facebook"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_social_facebook"
                app:iconGravity="textStart"
                app:strokeColor="@color/auth_divider"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewRegisterGoogle"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/auth_continue_google"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_social_google"
                app:iconGravity="textStart"
                app:strokeColor="@color/auth_divider"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewRegisterApple"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/auth_continue_apple"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_social_apple"
                app:iconGravity="textStart"
                app:strokeColor="@color/auth_divider"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_already_have_account"
                android:textColor="@color/auth_hint"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/registerLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/login_action"
                android:textColor="@color/auth_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
