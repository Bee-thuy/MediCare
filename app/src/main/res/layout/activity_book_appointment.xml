<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/bookAppointmentBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="@color/manager_ink"
            android:textSize="38sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Đặt lịch khám"
            android:textColor="@color/manager_ink"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Chọn thời gian phù hợp để gửi yêu cầu khám."
            android:textColor="@color/manager_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/patient_overview_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BÁC SĨ ĐÃ CHỌN"
                android:textColor="#DDEBFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookAppointmentDoctorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/bookAppointmentSpecialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#DDEBFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Chọn ngày khám"
            android:textColor="@color/manager_ink"
            android:textSize="17sp" />

        <AutoCompleteTextView
            android:id="@+id/bookAppointmentSchedule"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/manager_card_background"
            android:hint="Chọn ngày và ca làm việc"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:textColor="@color/manager_ink"
            android:textColorHint="@color/manager_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Chọn khung giờ"
            android:textColor="@color/manager_ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/bookAppointmentSlotsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hãy chọn lịch làm việc để xem giờ trống."
            android:textColor="@color/manager_muted" />

        <LinearLayout
            android:id="@+id/bookAppointmentSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Lý do khám"
            android:textColor="@color/manager_ink"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/bookAppointmentReason"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/manager_card_background"
            android:gravity="top"
            android:hint="Mô tả ngắn triệu chứng hoặc nhu cầu khám"
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/manager_ink"
            android:textColorHint="@color/manager_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bookAppointmentConfirm"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Gửi yêu cầu đặt lịch"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/patient_purple"
            app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
