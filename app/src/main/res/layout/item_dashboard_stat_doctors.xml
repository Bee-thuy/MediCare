<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="106dp"
    android:layout_marginEnd="6dp"
    android:layout_weight="1"
    android:background="@drawable/manager_stat_doctors_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="👨‍⚕️" android:textSize="21sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↗" android:textColor="#B2C0D1" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dashboardDoctorsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="—"
            android:textColor="@color/manager_ink"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tổng bác sĩ"
            android:textColor="@color/manager_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
