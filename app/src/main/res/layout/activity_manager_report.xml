<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@color/manager_blue_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/reportBack" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/role_header_action_background" android:gravity="center"
            android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Quản trị viên" android:textColor="#DDEBFF" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold" android:text="Thống kê báo cáo"
                android:textColor="@color/white" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/manager_card_background" android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold" android:text="Báo cáo tổng hợp"
                    android:textColor="@color/manager_ink" android:textSize="17sp" />
                <Spinner android:id="@+id/reportPeriod" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/reportTotal" style="@style/DoctorHomeStat"
                    android:background="@drawable/manager_stat_doctors_background" android:textColor="@color/manager_ink" />
                <TextView android:id="@+id/reportConfirmed" style="@style/DoctorHomeStat"
                    android:layout_marginStart="8dp" android:background="@drawable/manager_stat_patients_background"
                    android:textColor="@color/manager_ink" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/reportCompleted" style="@style/DoctorHomeStat"
                    android:background="@drawable/manager_stat_pending_background" android:textColor="@color/manager_ink" />
                <TextView android:id="@+id/reportDeclined" style="@style/DoctorHomeStat"
                    android:layout_marginStart="8dp" android:background="@drawable/manager_stat_schedules_background"
                    android:textColor="@color/manager_ink" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/manager_card_background"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold" android:text="Lượt khám theo ngày"
                    android:textColor="@color/manager_ink" android:textSize="14sp" />
                <LinearLayout android:id="@+id/reportChart" android:layout_width="match_parent"
                    android:layout_height="150dp" android:layout_marginTop="12dp"
                    android:gravity="bottom" android:orientation="horizontal" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Theo chuyên khoa" android:textColor="@color/manager_ink" android:textSize="15sp" />
            <LinearLayout android:id="@+id/reportSpecialties" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reportExport"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="16dp" android:text="↓  Xuất bảng CSV"
                android:textAllCaps="false" android:backgroundTint="@color/manager_blue"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
