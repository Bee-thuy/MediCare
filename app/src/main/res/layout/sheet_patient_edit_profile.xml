<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/patient_record_sheet_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">
    <View android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/patient_profile_sheet_handle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/patient_profile_header_icon_background"
            android:gravity="center" android:text="👤" android:textSize="22sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="11dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Chỉnh sửa hồ sơ cá nhân"
                android:textColor="@color/manager_ink" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cập nhật thông tin liên hệ của bạn"
                android:textColor="@color/manager_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/patientEditClose"
            style="@style/PatientAccountSheetClose"
            android:contentDescription="Đóng" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="17dp" android:background="@color/manager_border" />
    <TextView style="@style/PatientProfileFieldLabel"
        android:layout_marginTop="16dp" android:text="Họ và tên" />
    <EditText android:id="@+id/patientEditName" style="@style/PatientProfileField"
        android:hint="Nhập họ và tên" android:inputType="textPersonName|textCapWords" />
    <TextView style="@style/PatientProfileFieldLabel"
        android:layout_marginTop="12dp" android:text="Số điện thoại" />
    <EditText android:id="@+id/patientEditPhone" style="@style/PatientProfileField"
        android:hint="Nhập số điện thoại" android:inputType="phone" />
    <TextView style="@style/PatientProfileFieldLabel"
        android:layout_marginTop="12dp" android:text="Email đăng nhập" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/patient_profile_readonly_background"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="14dp">
        <TextView android:id="@+id/patientEditEmail"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end"
            android:singleLine="true" android:textColor="@color/manager_muted"
            android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="🔒"
            android:textSize="15sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Email được dùng để đăng nhập và không sửa tại đây"
        android:textColor="@color/manager_muted" android:textSize="10sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/patientEditSave"
        style="@style/PatientAccountSheetButton"
        android:layout_height="48dp" android:layout_marginTop="18dp"
        android:text="Lưu thay đổi" android:textSize="14sp" />
</LinearLayout>
