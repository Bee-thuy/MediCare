<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="70dp"
    android:layout_marginTop="9dp" android:background="@drawable/patient_booking_doctor_background"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingHorizontal="13dp">
    <TextView android:layout_width="43dp" android:layout_height="43dp"
        android:background="@drawable/patient_avatar_background" android:gravity="center"
        android:text="👨‍⚕️" android:textSize="22sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/patientBookingDoctorRowName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/inter_bold"
            android:textColor="@color/manager_ink" android:textSize="12sp" />
        <TextView android:id="@+id/patientBookingDoctorRowInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="@color/manager_muted" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/patientBookingDoctorRowSelected" android:layout_width="24dp"
        android:layout_height="wrap_content" android:gravity="center"
        android:text="○" android:textColor="@color/manager_ink" android:textSize="20sp" />
</LinearLayout>
