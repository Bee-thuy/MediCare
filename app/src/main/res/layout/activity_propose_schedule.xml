<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/patient_record_sheet_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PatientAccountSheetTitle"
            android:text="@string/manager_propose_schedule_title" />

        <TextView
            android:id="@+id/proposeScheduleBack"
            style="@style/PatientAccountSheetClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/manager_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/manager_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="@string/manager_propose_patient_label"
                        android:textColor="@color/manager_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/proposeSchedulePatient"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="end"
                        android:textColor="@color/manager_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="@string/manager_propose_requested_time_label"
                        android:textColor="@color/manager_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/proposeScheduleRequested"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="end"
                        android:textColor="@color/manager_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/proposeScheduleInfo"
                style="@style/ClinicalLabel"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/manager_propose_new_time_label" />

            <GridLayout
                android:id="@+id/proposeSlotGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3" />

            <TextView
                style="@style/ClinicalLabel"
                android:layout_marginTop="16dp"
                android:text="@string/manager_optional_note" />

            <EditText
                android:id="@+id/proposeScheduleNote"
                style="@style/ClinicalField"
                android:layout_height="96dp"
                android:gravity="top|start"
                android:hint="@string/manager_propose_note_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="200" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/proposeScheduleSend"
        style="@style/ClinicalButton"
        android:text="@string/manager_send_proposal"
        app:backgroundTint="@color/manager_blue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/proposeScheduleCancel"
        style="@style/ClinicalButton"
        android:layout_marginTop="8dp"
        android:text="@string/manager_cancel"
        android:textColor="@color/manager_blue"
        app:backgroundTint="@color/patient_hero_blue" />
</LinearLayout>
