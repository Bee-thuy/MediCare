<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/proposeScheduleBack"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="@color/manager_ink"
            android:textSize="40sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/manager_propose_schedule_title"
            android:textColor="@color/manager_ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/manager_quick_action_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_manager_notifications"
                    android:tint="@color/manager_blue" />

                <TextView
                    android:id="@+id/proposeScheduleInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/manager_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="4"
                android:rowCount="2">

                <TextView
                    android:id="@+id/proposeSlot0830"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="08:30"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot0900"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="09:00"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot0930"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="09:30"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot1000"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="10:00"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot1030"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="10:30"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot1100"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="11:00"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proposeSlot1130"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/manager_time_option_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="11:30"
                    android:textColor="@color/manager_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/manager_optional_note"
                android:textColor="@color/manager_ink"
                android:textSize="17sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:counterEnabled="true"
                app:counterMaxLength="200">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/proposeScheduleNote"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/manager_card_background"
                    android:gravity="top|start"
                    android:hint="@string/manager_propose_note_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:padding="14dp"
                    android:textColor="@color/manager_ink"
                    android:textColorHint="@color/manager_muted"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/proposeScheduleCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/manager_card_background"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="@string/manager_cancel"
            android:textAllCaps="false"
            android:textColor="@color/manager_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/proposeScheduleSend"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/manager_button_background"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="@string/manager_send_proposal"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
