<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background"
    android:orientation="vertical">
  <LinearLayout
    android:id="@+id/managerBottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/manager_header_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">
    <TextView
    android:id="@+id/managerMenuButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:contentDescription="Mở danh mục"
    android:gravity="center"
    android:background="@drawable/manager_header_action_background"
    android:text="☰"
    android:textColor="@color/white"
    android:textSize="20sp"/>
    <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Smart Healthcare · Quản trị viên" android:textColor="#DDEBFF"
        android:textSize="10sp"/>
      <TextView
        android:id="@+id/managerHeaderTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Tổng quan" android:textColor="@color/white" android:textSize="18sp"/>
    </LinearLayout>
    <FrameLayout
    android:id="@+id/managerNotificationButton"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@drawable/role_header_action_background"
    android:clickable="true"
    android:contentDescription="@string/manager_notifications"
    android:focusable="true">
      <ImageView
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_gravity="center"
    android:src="@drawable/ic_manager_notifications"
    android:tint="@color/white"/>
      <TextView
        android:id="@+id/managerNotificationBadge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/notification_badge_background"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/managerFragmentContainer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/white"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp">
    <include
      android:id="@+id/managerNavHomeInclude"
      layout="@layout/item_manager_bottom_navigation_home"/>
    <include
      android:id="@+id/managerNavDoctorsInclude"
      layout="@layout/item_manager_bottom_navigation_doctors"/>
    <include
      android:id="@+id/managerNavPatientsInclude"
      layout="@layout/item_manager_bottom_navigation_patients"/>
    <include
      android:id="@+id/managerNavNotificationsInclude"
      layout="@layout/item_manager_bottom_navigation_notifications"/>
    <include
      android:id="@+id/managerNavMoreInclude"
      layout="@layout/item_manager_bottom_navigation_more"/>
  </LinearLayout>
</LinearLayout>
