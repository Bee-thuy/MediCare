<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_background"
    android:orientation="vertical">
  <LinearLayout
    android:id="@+id/managerBottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp">
    <ImageView
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:contentDescription="@string/app_name"
    android:src="@drawable/ic_manager_shield"/>
    <TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:fontFamily="@font/plus_jakarta_sans_bold"
    android:text="@string/manager_title"
    android:textColor="@color/manager_blue_dark"
    android:textSize="20sp"/>
    <FrameLayout
    android:id="@+id/managerNotificationButton"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/manager_notifications"
    android:focusable="true">
      <ImageView
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_gravity="center"
    android:src="@drawable/ic_manager_notifications"
    android:tint="@color/manager_ink"/>
      <View
    android:layout_width="10dp"
    android:layout_height="10dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="7dp"
    android:background="@drawable/manager_pending_badge"/>
    </FrameLayout>
  </LinearLayout>
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/managerFragmentContainer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/white"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp">
    <include
      android:id="@+id/managerNavHomeInclude"
      layout="@layout/item_manager_bottom_navigation_home"/>
    <include
      android:id="@+id/managerNavDoctorsInclude"
      layout="@layout/item_manager_bottom_navigation_doctors"/>
    <include
      android:id="@+id/managerNavPatientsInclude"
      layout="@layout/item_manager_bottom_navigation_patients"/>
    <include
      android:id="@+id/managerNavNotificationsInclude"
      layout="@layout/item_manager_bottom_navigation_notifications"/>
    <include
      android:id="@+id/managerNavMoreInclude"
      layout="@layout/item_manager_bottom_navigation_more"/>
  </LinearLayout>
</LinearLayout>
