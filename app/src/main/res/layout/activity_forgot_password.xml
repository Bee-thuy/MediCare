<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="92dp"
            android:background="@drawable/patient_header_background" android:gravity="center_vertical"
            android:paddingHorizontal="20dp">
            <ImageButton android:id="@+id/forgotBack" android:layout_width="40dp"
                android:layout_height="40dp" android:background="@drawable/patient_auth_header_button_background"
                android:contentDescription="@string/auth_back" android:padding="10dp"
                android:src="@drawable/ic_auth_back" android:tint="@color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Smart Healthcare · Bệnh nhân" android:textColor="#DCD4FF" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Đăng ký &amp; đăng nhập" android:textColor="@color/white"
                    android:textSize="19sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/patient_auth_header_button_background"
                android:gravity="center" android:text="🔔" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingHorizontal="24dp" android:paddingTop="22dp" android:paddingBottom="32dp">
            <TextView android:layout_width="72dp" android:layout_height="72dp"
                android:background="@drawable/patient_auth_hero_background"
                android:gravity="center" android:text="💙" android:textSize="40sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:text="Chào mừng đến với&#10;Smart Healthcare"
                android:textColor="@color/manager_ink" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center"
                android:text="@string/login_subtitle"
                android:textColor="@color/manager_muted" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/forgotLoginLink" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:background="@drawable/patient_auth_chip_background"
                    android:gravity="center" android:paddingHorizontal="16dp" android:text="Đăng nhập"
                    android:textColor="@color/manager_muted" android:textSize="12sp" />
                <TextView android:id="@+id/forgotRegisterLink" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:layout_marginStart="7dp"
                    android:background="@drawable/patient_auth_chip_background"
                    android:gravity="center" android:paddingHorizontal="16dp" android:text="Đăng ký"
                    android:textColor="@color/manager_muted" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/patient_auth_selected_chip_background"
                    android:gravity="center" android:paddingHorizontal="13dp"
                    android:text="Quên mật khẩu" android:textColor="@color/white"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="15dp" android:background="@drawable/patient_auth_card_background"
              android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/forgotTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/forgot_title"
                    android:textColor="@color/manager_ink" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/forgotSubtitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="@string/forgot_subtitle"
                    android:textColor="@color/manager_muted" android:textSize="13sp" />
                <TextView style="@style/PatientProfileFieldLabel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Email" />
                <EditText android:id="@+id/forgotEmailInput" style="@style/PatientAuthInput"
                    android:layout_marginTop="6dp" android:autofillHints="emailAddress"
                    android:hint="ten@email.com" android:inputType="textEmailAddress" />
                <TextView android:id="@+id/forgotMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/auth_message_background" android:padding="10dp"
                    android:textColor="@color/manager_ink" android:textSize="13sp" android:visibility="gone" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/forgotButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_action"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/patient_purple"
                        app:cornerRadius="12dp" />

                    <ProgressBar
                        android:id="@+id/forgotLoading"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/patient_purple"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
