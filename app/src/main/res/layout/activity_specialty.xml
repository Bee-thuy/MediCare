<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@drawable/manager_header_background"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView android:id="@+id/manageSpecialtiesBack" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="‹" android:textColor="@color/white"
            android:textSize="28sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Quản trị viên" android:textColor="#DDEBFF"
                android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Danh mục chuyên khoa" android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Chuyên khoa bệnh viện" android:textColor="@color/manager_ink"
                    android:textSize="13sp" />
                <TextView android:id="@+id/manageSpecialtiesAdd" android:layout_width="wrap_content"
                    android:layout_height="40dp" android:gravity="center_vertical"
                    android:text="+ Thêm  ›" android:textColor="@color/manager_blue"
                    android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <EditText android:id="@+id/manageSpecialtiesSearch"
                android:layout_width="match_parent" android:layout_height="43dp"
                android:layout_marginTop="10dp" android:background="@drawable/manager_card_background"
                android:hint="🔍 Tìm chuyên khoa..." android:inputType="text"
                android:paddingHorizontal="13dp" android:singleLine="true"
                android:textColor="@color/manager_ink" android:textColorHint="@color/manager_muted"
                android:textSize="12sp" />
            <TextView android:id="@+id/manageSpecialtiesEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="30dp" android:gravity="center" android:padding="20dp"
                android:text="Chưa có chuyên khoa phù hợp" android:textColor="@color/manager_muted"
                android:textSize="12sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/manageSpecialtiesList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical" />
            <TextView android:id="@+id/manageSpecialtiesBottomAdd"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="12dp" android:background="@drawable/manager_button_background"
                android:gravity="center" android:text="+ Thêm chuyên khoa"
                android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/manager_info_background"
                android:padding="13dp"
                android:text="ℹ️  Chuyên khoa có liên kết với bác sĩ hoặc lịch khám sẽ được ẩn thay vì xóa cứng."
                android:textColor="@color/manager_blue_dark" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
