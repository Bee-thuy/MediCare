<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@drawable/manager_header_background"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView android:id="@+id/manageSpecialtiesBack" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="☰" android:textColor="@color/white"
            android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Quản trị viên" android:textColor="#DDEBFF"
                android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Danh mục chuyên khoa" android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/managerAuxNotificationButton"
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="🔔" android:textSize="21sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Chuyên khoa bệnh viện" android:textColor="@color/manager_ink"
                    android:textSize="13sp" />
                <TextView android:id="@+id/manageSpecialtiesAdd" android:layout_width="wrap_content"
                    android:layout_height="40dp" android:gravity="center_vertical"
                    android:text="+ Thêm  ›" android:textColor="@color/manager_blue"
                    android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <EditText android:id="@+id/manageSpecialtiesSearch"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/assign_schedule_select_background"
                android:drawableStart="@drawable/ic_nav_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/manager_muted"
                android:hint="Tìm chuyên khoa..."
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/manager_ink"
                android:textColorHint="@color/manager_muted"
                android:textSize="13sp" />
            <TextView android:id="@+id/manageSpecialtiesEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="30dp" android:gravity="center" android:padding="20dp"
                android:text="Chưa có chuyên khoa phù hợp" android:textColor="@color/manager_muted"
                android:textSize="12sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/manageSpecialtiesList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/manager_info_background"
                android:fontFamily="@font/inter_medium"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Chuyên khoa đang gắn bác sĩ/lịch khám sẽ được ẩn thay vì xóa cứng."
                android:textColor="@color/manager_blue" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/manageSpecialtiesBottomAdd"
        style="@style/ClinicalButton"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="+ Thêm chuyên khoa"
        app:backgroundTint="@color/manager_blue"
        app:icon="@null" />
    <include layout="@layout/view_manager_aux_navigation" />
</LinearLayout>
