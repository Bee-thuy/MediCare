<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="36dp"
    android:fontFamily="@font/plus_jakarta_sans_bold"
    android:text="@string/manager_notifications"
    android:textColor="@color/manager_ink"
    android:textSize="26sp"/>
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:fontFamily="@font/plu_jakarta_sans_regular"
    android:text="@string/manager_notifications_description"
    android:textColor="@color/manager_muted"
    android:textSize="16sp"/>
</LinearLayout>
