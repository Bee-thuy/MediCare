<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/doctorSlotTime"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/manager_card_background"
        android:gravity="center"
        android:textColor="@color/manager_blue"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/doctorSlotStatus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1.1"
        android:background="@drawable/manager_quick_action_background"
        android:gravity="center"
        android:textColor="@color/manager_blue"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
