<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    android:paddingHorizontal="28dp">

    <ImageView
        android:id="@+id/roleHomeLogo"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/medicare_logo_oval"
        app:layout_constraintBottom_toTopOf="@id/roleHomeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/roleHomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center"
        android:textColor="@color/onboarding_title"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@id/roleHomeDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roleHomeLogo" />

    <TextView
        android:id="@+id/roleHomeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/onboarding_body"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/roleHomeLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roleHomeTitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/roleHomeLogout"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/onboarding_button_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/auth_logout"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roleHomeDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
