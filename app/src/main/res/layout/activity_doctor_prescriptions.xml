<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:orientation="vertical">
    <LinearLayout android:id="@+id/doctorPrescriptionsHeader" android:layout_width="match_parent" android:layout_height="74dp"
        android:background="@color/doctor_teal_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/doctorPrescriptionsBack" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/role_header_action_background"
            android:gravity="center" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Smart Healthcare · Bác sĩ" android:textColor="#D7F4E9" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold" android:text="Đơn thuốc điện tử"
                android:textColor="@color/white" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:fontFamily="@font/inter_bold"
                    android:text="Đơn thuốc đã kê" android:textColor="@color/manager_ink" android:textSize="13sp" />
                <TextView android:id="@+id/doctorPrescriptionsNew" android:layout_width="wrap_content"
                    android:layout_height="44dp" android:gravity="center_vertical"
                    android:text="+ Kê đơn  ›" android:textColor="@color/doctor_teal" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/doctorPrescriptionsList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
            <TextView android:id="@+id/doctorPrescriptionsEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:padding="20dp"
                android:text="Chưa có đơn thuốc đã kê." android:textColor="@color/manager_muted"
                android:textSize="11sp" android:visibility="gone" />
            <TextView android:id="@+id/doctorPrescriptionsBottomNew" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="4dp"
                android:background="@drawable/doctor_primary_button_background" android:gravity="center"
                android:text="+ Tạo đơn thuốc từ lượt khám" android:textColor="@color/white"
                android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="13dp" android:background="@drawable/manager_info_background"
                android:padding="14dp" android:text="ℹ️ Liều dùng và hướng dẫn được bác sĩ ghi trong lượt khám đang thực hiện."
                android:textColor="@color/doctor_teal_dark" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
