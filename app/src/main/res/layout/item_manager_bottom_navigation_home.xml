<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/managerNavHome"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/managerNavHomeIcon"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:background="@drawable/manager_nav_icon_background"
        android:contentDescription="@null"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_dashboard"
        android:tint="@color/nav_tint_manager" />

    <TextView
        android:id="@+id/managerNavHomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:includeFontPadding="false"
        android:text="@string/manager_home"
        android:textColor="@color/nav_tint_manager"
        android:textSize="10sp" />
</LinearLayout>
