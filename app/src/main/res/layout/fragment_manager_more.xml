<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Danh mục quản trị" android:textSize="22sp" android:textColor="@color/manager_ink"
            android:fontFamily="@font/plus_jakarta_sans_bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="8 nhóm chức năng dành cho Admin"
            android:textColor="@color/manager_muted" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/manager_card_background"
            android:orientation="vertical" android:padding="7dp">
            <TextView android:id="@+id/managerMoreDashboard" style="@style/ManagerCatalogRow" android:text="📊   Tổng quan" />
            <TextView android:id="@+id/managerMoreAppointments" style="@style/ManagerCatalogRow" android:text="🗓️   Yêu cầu đặt lịch" />
            <TextView android:id="@+id/managerMoreDoctors" style="@style/ManagerCatalogRow" android:text="👨‍⚕️   Quản lý bác sĩ" />
            <TextView android:id="@+id/managerMorePatients" style="@style/ManagerCatalogRow" android:text="👥   Quản lý bệnh nhân" />
            <TextView android:id="@+id/managerMoreSchedules" style="@style/ManagerCatalogRow" android:text="📅   Lịch làm việc" />
            <TextView android:id="@+id/managerMoreSpecialties" style="@style/ManagerCatalogRow" android:text="🧬   Danh mục chuyên khoa" />
            <TextView android:id="@+id/managerMoreNotifications" style="@style/ManagerCatalogRow" android:text="🔔   Thông báo" />
            <TextView android:id="@+id/managerMoreReports" style="@style/ManagerCatalogRow" android:text="📈   Thống kê báo cáo" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Công cụ bổ sung"
            android:textColor="@color/manager_ink" android:textSize="15sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/manager_card_background"
            android:orientation="vertical" android:padding="7dp">
            <TextView android:id="@+id/managerMoreWorkShifts" style="@style/ManagerCatalogRow" android:text="◷   Quản lý ca làm" />
            <TextView android:id="@+id/managerMoreLeaveRequests" style="@style/ManagerCatalogRow" android:text="✉   Yêu cầu nghỉ / đổi ca" />
            <TextView android:id="@+id/managerMoreReviews" style="@style/ManagerCatalogRow" android:text="★   Đánh giá bác sĩ" />
            <TextView android:id="@+id/managerMoreDoctorChat" style="@style/ManagerCatalogRow" android:text="💬   Chat với bác sĩ" />
            <TextView android:id="@+id/managerMoreBroadcast" style="@style/ManagerCatalogRow" android:text="✉   Gửi thông báo toàn bệnh viện" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/managerMoreSignOut"
            android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp"
            android:text="@string/manager_sign_out" android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
