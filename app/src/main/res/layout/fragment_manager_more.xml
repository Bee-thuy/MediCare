<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="36dp"
    android:fontFamily="@font/plus_jakarta_sans_bold"
    android:text="@string/manager_more"
    android:textColor="@color/manager_ink"
    android:textSize="26sp"/>
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:fontFamily="@font/plu_jakarta_sans_regular"
    android:text="@string/manager_more_description"
    android:textColor="@color/manager_muted"
    android:textSize="16sp"/>
  <com.google.android.material.button.MaterialButton
    android:id="@+id/managerMoreSpecialties"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="28dp"
    android:text="@string/manager_specialties"
    android:textAllCaps="false"
    android:textColor="@color/manager_blue"/>
  <com.google.android.material.button.MaterialButton
    android:id="@+id/managerMoreWorkShifts"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="10dp"
    android:text="@string/manager_work_shifts"
    android:textAllCaps="false"
    android:textColor="@color/manager_blue"/>
  <com.google.android.material.button.MaterialButton
    android:id="@+id/managerMoreSignOut"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="30dp"
    android:background="@drawable/manager_button_background"
    android:text="@string/manager_sign_out"
    android:textAllCaps="false"
    android:textColor="@color/white"/>
</LinearLayout>
