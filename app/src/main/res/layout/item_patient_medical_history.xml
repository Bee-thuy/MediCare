<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="9dp" android:background="@drawable/manager_card_background"
    android:orientation="vertical" android:padding="15dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/patientHistoryDiagnosis" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/inter_bold" android:textColor="@color/manager_ink"
            android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/patient_completed_status_background"
            android:paddingHorizontal="8dp" android:paddingVertical="5dp"
            android:text="Hoàn thành" android:textColor="@color/manager_blue_dark"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout style="@style/DoctorProfileRow">
        <TextView style="@style/DoctorProfileLabel" android:text="Bác sĩ" />
        <TextView android:id="@+id/patientHistoryDoctor" style="@style/DoctorProfileValue" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="@drawable/patient_record_divider" />
    <LinearLayout style="@style/DoctorProfileRow">
        <TextView style="@style/DoctorProfileLabel" android:text="Mã lượt khám" />
        <TextView android:id="@+id/patientHistoryId" style="@style/DoctorProfileValue"
            android:ellipsize="end" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="@drawable/patient_record_divider" />
    <LinearLayout style="@style/DoctorProfileRow">
        <TextView style="@style/DoctorProfileLabel" android:text="Ngày khám" />
        <TextView android:id="@+id/patientHistoryDate" style="@style/DoctorProfileValue" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginTop="9dp" android:orientation="horizontal">
        <TextView android:id="@+id/patientHistoryResult" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/patient_secondary_button_background"
            android:gravity="center" android:text="Xem kết quả"
            android:textColor="@color/patient_purple" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/patientHistoryPrescription" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_marginStart="8dp"
            android:layout_weight="1" android:background="@drawable/patient_booking_button_background"
            android:gravity="center" android:text="Xem đơn thuốc"
            android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
