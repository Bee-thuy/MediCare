<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/manager_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="92dp"
            android:background="@drawable/patient_header_background" android:gravity="center_vertical"
            android:paddingHorizontal="20dp">
            <ImageButton android:id="@+id/loginBackButton" android:layout_width="40dp"
                android:layout_height="40dp" android:background="@drawable/patient_auth_header_button_background"
                android:contentDescription="@string/auth_back" android:padding="10dp"
                android:src="@drawable/ic_auth_back" android:tint="@color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Smart Healthcare · Bệnh nhân" android:textColor="#DCD4FF" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Đăng ký &amp; đăng nhập" android:textColor="@color/white"
                    android:textSize="19sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/patient_auth_header_button_background"
                android:gravity="center" android:text="🔔" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingHorizontal="24dp" android:paddingTop="22dp" android:paddingBottom="32dp">
            <TextView android:layout_width="72dp" android:layout_height="72dp"
                android:background="@drawable/patient_auth_hero_background"
                android:gravity="center" android:text="💙" android:textSize="40sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:text="Chào mừng đến với&#10;Smart Healthcare"
                android:textColor="@color/manager_ink" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center"
                android:text="Bảo vệ sức khỏe của bạn mỗi ngày"
                android:textColor="@color/manager_muted" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                    android:background="@drawable/patient_auth_selected_chip_background"
                    android:gravity="center" android:paddingHorizontal="16dp" android:text="Đăng nhập"
                    android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/loginRegisterLink" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:layout_marginStart="7dp"
                    android:background="@drawable/patient_auth_chip_background"
                    android:gravity="center" android:paddingHorizontal="16dp" android:text="Đăng ký"
                    android:textColor="@color/manager_muted" android:textSize="12sp" />
                <TextView android:id="@+id/loginForgotPasswordLink" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:layout_marginStart="7dp"
                    android:background="@drawable/patient_auth_chip_background"
                    android:gravity="center" android:paddingHorizontal="13dp"
                    android:text="Quên mật khẩu" android:textColor="@color/manager_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="15dp" android:background="@drawable/patient_auth_card_background"
                android:elevation="2dp" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/PatientProfileFieldLabel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Email" />
                <EditText android:id="@+id/loginEmailInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress" android:background="@drawable/patient_profile_field_background"
                    android:hint="ten@email.com" android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp" android:singleLine="true"
                    android:textColor="@color/manager_ink" android:textSize="14sp" />
                <TextView style="@style/PatientProfileFieldLabel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Mật khẩu" />
                <EditText android:id="@+id/loginPasswordInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="6dp"
                    android:autofillHints="password" android:background="@drawable/patient_profile_field_background"
                    android:hint="Ít nhất 6 ký tự" android:inputType="textPassword"
                    android:paddingHorizontal="14dp" android:singleLine="true"
                    android:textColor="@color/manager_ink" android:textSize="14sp" />
                <TextView android:id="@+id/loginMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/auth_message_background" android:padding="10dp"
                    android:textColor="@color/manager_ink" android:textSize="13sp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loginButton"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="14dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Đăng nhập" android:textAllCaps="false" android:textColor="@color/white"
                    android:textSize="14sp" android:textStyle="bold"
                    app:backgroundTint="@color/patient_purple" app:cornerRadius="12dp" />
                <ProgressBar android:id="@+id/loginLoading" android:layout_width="28dp"
                    android:layout_height="28dp" android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" android:indeterminateTint="@color/patient_purple"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/loginQuickAccounts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" android:text="Đăng nhập nhanh để kiểm thử"
                    android:textColor="@color/manager_ink" android:textSize="14sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loginQuickAdmin"
                    style="@style/QuickTestAccountButton" android:text="Quản trị viên" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loginQuickDoctor"
                    style="@style/QuickTestAccountButton" android:layout_marginTop="8dp" android:text="Bác sĩ" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loginQuickPatient"
                    style="@style/QuickTestAccountButton" android:layout_marginTop="8dp" android:text="Bệnh nhân" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
