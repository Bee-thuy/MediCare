<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="9dp" android:background="@drawable/manager_card_background"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="13dp">
    <TextView android:id="@+id/doctorPatientAvatar" android:layout_width="44dp"
        android:layout_height="44dp" android:background="@drawable/doctor_avatar_background"
        android:gravity="center" android:text="👤" android:textSize="19sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/doctorPatientName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/manager_ink" android:textSize="12sp" />
        <TextView android:id="@+id/doctorPatientInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:maxLines="2" android:textColor="@color/manager_muted" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/doctorPatientUnreadBadge" android:layout_width="22dp"
        android:layout_height="22dp" android:background="@drawable/manager_button_background"
        android:gravity="center" android:textColor="@color/white" android:textSize="10sp"
        android:visibility="gone" />
    <TextView android:layout_width="20dp" android:layout_height="wrap_content"
        android:gravity="end" android:text="›" android:textColor="@color/manager_muted"
        android:textSize="24sp" />
</LinearLayout>
