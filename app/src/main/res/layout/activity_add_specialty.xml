<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/patient_record_sheet_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/patient_profile_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addSpecialtyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Thêm chuyên khoa"
                android:textColor="@color/manager_ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/addSpecialtySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tên và biểu tượng hiển thị cho bệnh nhân"
                android:textColor="@color/manager_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/addSpecialtyBack"
            style="@style/PatientAccountSheetClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/manager_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/manager_info_background"
                android:fontFamily="@font/inter_medium"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Chuyên khoa dùng để nhóm bác sĩ và lọc khi bệnh nhân tìm kiếm / đặt lịch."
                android:textColor="@color/manager_blue"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/manager_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Tên chuyên khoa"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addSpecialtyNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/manager_border"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/addSpecialtyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ví dụ: Nội tiết"
                        android:inputType="textCapWords"
                        android:minHeight="48dp"
                        android:textColor="@color/manager_ink"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Mô tả (tùy chọn)"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/addSpecialtyDescription"
                    style="@style/ClinicalField"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:gravity="top|start"
                    android:hint="Mô tả ngắn giúp bệnh nhân hiểu chuyên khoa"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Biểu tượng"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/addSpecialtyIconChoice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/assign_schedule_select_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/addSpecialtyIconPreview"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/manager_appointment_avatar_background"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:src="@drawable/ic_manager_specialty" />

                    <TextView
                        android:id="@+id/addSpecialtyIconLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Tổng quát"
                        android:textColor="@color/manager_ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_select_chevron"
                        android:tint="@color/manager_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="#EEF2F8" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addSpecialtySave"
        style="@style/ClinicalButton"
        android:text="Lưu chuyên khoa"
        app:backgroundTint="@color/manager_blue"
        app:icon="@drawable/ic_visit_check"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addSpecialtyCancel"
        style="@style/ClinicalButton.Outline"
        android:layout_marginTop="8dp"
        android:background="@drawable/doctor_visit_button_outline"
        android:text="@string/manager_cancel"
        android:textColor="@color/manager_blue"
        app:backgroundTint="@null"
        app:icon="@null"
        app:strokeColor="@color/manager_border" />
</LinearLayout>
