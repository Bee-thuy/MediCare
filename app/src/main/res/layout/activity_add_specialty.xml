<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/patient_record_sheet_background"
    android:orientation="vertical" android:paddingHorizontal="20dp"
    android:paddingTop="18dp" android:paddingBottom="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Thêm chuyên khoa" android:textColor="@color/manager_ink"
            android:textSize="24sp" />
        <TextView android:id="@+id/addSpecialtyBack" android:layout_width="42dp"
            android:layout_height="42dp" android:background="@drawable/manager_avatar_placeholder"
            android:gravity="center" android:text="×" android:textColor="@color/manager_muted"
            android:textSize="26sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addSpecialtyNameLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="Tên chuyên khoa">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/addSpecialtyName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Ví dụ: Nội tiết"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Biểu tượng" android:textColor="@color/manager_ink"
                android:textSize="15sp" />
            <TextView android:id="@+id/addSpecialtyIconChoice"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="8dp" android:background="@drawable/manager_form_field_background"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                android:paddingHorizontal="16dp" android:text="🩺"
                android:textColor="@color/manager_ink" android:textSize="22sp" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addSpecialtySave" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="8dp"
        android:text="Lưu chuyên khoa" android:textAllCaps="false"
        android:textColor="@color/white" app:backgroundTint="@color/manager_blue"
        app:cornerRadius="14dp" />
</LinearLayout>
