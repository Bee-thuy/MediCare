<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/managerNavNotifications"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">
  <TextView
    android:id="@+id/managerNavNotificationsIcon"
    android:layout_width="39dp"
    android:layout_height="32dp"
    android:background="@drawable/manager_nav_icon_background"
    android:contentDescription="@null"
    android:gravity="center" android:text="👥" android:textSize="21sp"/>
  <TextView
    android:id="@+id/managerNavNotificationsLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:fontFamily="@font/plus_jakarta_sans_medium"
    android:text="@string/manager_patients"
    android:textColor="@color/manager_muted"
    android:textSize="10sp"/>
</LinearLayout>
