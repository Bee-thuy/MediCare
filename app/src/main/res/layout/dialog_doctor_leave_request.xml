<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/doctor_leave_sheet_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/patient_profile_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Xin nghỉ / đổi ca"
                    android:textColor="@color/manager_ink"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Yêu cầu sẽ được gửi tới Admin để duyệt"
                    android:textColor="@color/manager_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/doctorLeaveClose"
                style="@style/PatientAccountSheetClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/manager_close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/doctor_visit_hint_background"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="Xin nghỉ sẽ khóa ca trong ngày. Đổi ca chỉ gửi đề nghị để Admin phân công lại."
            android:textColor="@color/doctor_teal_dark"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_bold"
            android:text="Ngày đề nghị"
            android:textColor="@color/manager_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/doctorLeaveDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/assign_schedule_select_background"
            android:drawableEnd="@drawable/ic_nav_calendar"
            android:drawablePadding="8dp"
            android:drawableTint="@color/manager_muted"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:textColor="@color/manager_ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_bold"
            android:text="Loại yêu cầu"
            android:textColor="@color/manager_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/doctorLeaveTypeRest"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/leave_type_chip_background"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Xin nghỉ"
                android:textColor="@color/doctor_teal_dark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/doctorLeaveTypeChange"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/leave_type_chip_background"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Đổi ca"
                android:textColor="@color/manager_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/doctorLeaveType"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_bold"
            android:text="Lý do"
            android:textColor="@color/manager_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/doctorLeaveReason"
            style="@style/ClinicalField"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:hint="Nhập lý do đề nghị"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="250" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doctorLeaveSubmit"
            style="@style/ClinicalButton"
            android:layout_marginTop="18dp"
            android:text="Gửi Admin duyệt"
            app:backgroundTint="@color/doctor_teal"
            app:icon="@drawable/ic_action_leave"
            app:iconTint="@color/white" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
