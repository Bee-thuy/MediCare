<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/doctor_leave_sheet_background"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <View android:layout_width="38dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="22dp"
            android:background="@drawable/patient_profile_sheet_handle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="📅 Xin nghỉ / đổi ca"
                android:textColor="@color/manager_ink" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/doctorLeaveClose" android:layout_width="42dp"
                android:layout_height="42dp" android:background="@drawable/patient_auth_hero_background"
                android:contentDescription="Đóng" android:gravity="center"
                android:text="×" android:textColor="@color/manager_muted" android:textSize="26sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Ngày đề nghị"
            android:textColor="@color/manager_muted" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/doctorLeaveDate" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="6dp"
            android:background="@drawable/doctor_profile_edit_field_background"
            android:gravity="center_vertical" android:paddingHorizontal="16dp"
            android:textColor="@color/manager_ink" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Loại yêu cầu"
            android:textColor="@color/manager_muted" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/doctorLeaveType" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="6dp"
            android:background="@drawable/doctor_profile_edit_field_background"
            android:paddingHorizontal="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Lý do"
            android:textColor="@color/manager_muted" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/doctorLeaveReason" android:layout_width="match_parent"
            android:layout_height="110dp" android:layout_marginTop="6dp"
            android:background="@drawable/doctor_profile_edit_field_background"
            android:gravity="top|start" android:hint="Nhập lý do đề nghị"
            android:inputType="textMultiLine" android:padding="16dp"
            android:textColor="@color/manager_ink" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/doctorLeaveSubmit"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="18dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="Gửi Admin duyệt" android:textAllCaps="false"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
            app:backgroundTint="@color/doctor_teal" app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
